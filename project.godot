; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rogue-soul"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://src/infrastructure/game_config.gd"
RNGService="*res://src/infrastructure/rng_service.gd"
SignalBus="*res://src/infrastructure/signal_bus.gd"
PersistenceService="*res://src/infrastructure/persistence_service.gd"
EventLog="*res://src/infrastructure/event_log.gd"
ContentRegistry="*res://src/application/content_registry.gd"
SaveManager="*res://src/application/save_manager.gd"
ScreenManager="*res://src/application/screen_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
